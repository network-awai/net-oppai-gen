{
  "$schema": "node_modules/wrangler/config-schema.json",
  // oppai.fans. Build: npm run build (generates public/index.html from
  // oppai.gen.site, then amu compile --target wasm32-browser app worker -> public/assets/main.js
  // + dist/worker.js). Deploy: npm run deploy.
  //
  // The Worker owns /api/*; everything else falls through to the static
  // assets. Same routing discipline as network-awai-apex: image generation
  // and the fleet model map go browser-direct (Cloudflare 100 s ceiling),
  // chat and video pass through here.
  //
  // Secret, set out of band with `wrangler secret put`, NOT in this file:
  //   MURAKUMO_GENERATION_TOKEN  signed murakumo capability, scope=generation
  // The Worker owns /api/*: image AND video jobs (token proxy), the node's
  // image-model list, and the face ceremony (/api/face/*).
  // Optional: OPPAI_CHAT_MODEL=awai-network/basho, OPPAI_VIDEO_MODEL=hokusai
  "name": "oppai-fans",
  "main": "dist/worker.js",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "oppai.fans", "custom_domain": true },
    { "pattern": "www.oppai.fans", "custom_domain": true }
  ],
  // Face enrolments + challenge nonces (oppai.gen.guard). KV is the right
  // plane for this: session-shaped, TTL-expiring, per-browser, and the
  // record is the person's own frame — nothing durable, nothing shared,
  // nothing to reconstruct (CLAUDE.md: KV for session/cache only, and an
  // enrolment IS a session). Created 2026-09-11 with `wrangler kv namespace
  // create OPPAI_KV`.
  "kv_namespaces": [
    { "binding": "OPPAI_KV", "id": "0b84f6a6905644c68f60eb693d15c6b1" }
  ],
  "d1_databases": [{"binding": "OPPAI_DB", "database_name": "oppai-feedback", "database_id": "5ade2f09-54d1-4bca-a182-1185bc39a47b", "migrations_dir": "migrations"}],
  "triggers": {"crons": ["17 * * * *"]},
  "observability": { "enabled": true }
}
