#?(:cljs
   (defn home-view []
     [:div {:class "oppai-discovery"}
      [:div {:class "oppai-discovery-intro"}
       [:div [:p {:class "oppai-eyebrow"} "CREATE YOUR NEXT CHARACTER"]
        [:h2 "ひらめきを、次の一枚に。"]
        [:p "キャラクターも、ポートレートも。無料でつくろう。"]
        (ui/button "画像を作成" {:href "#image" :variant :primary})]
       [:img {:src "/img/producer-character-20260911.png" :alt "Producer のキャラクター作例"}]]
      [section-heading "AIツール" "#tools"]
      [:div {:class "oppai-quick-tools"}
       (for [[href title image] [["#image" "画像作成" "/img/producer-character-20260911.png"]
                                 ["#producer" "キャラクター企画" "/img/producer-portrait-20260911.png"]
                                 ["#douga" "画像から動画" "/img/free-garden.png"]]]
         ^{:key href} [:a {:href href} [:img {:src image :alt "" :loading "lazy"}] [:strong title]])]
      [section-heading "モデル" "#models"]
      [:div {:class "oppai-cards"}
       (for [c (filter #(contains? #{"animagine-xl-4.0" "waiREALMIX_v11"} (:id %)) catalog/cards)] ^{:key (:id c)} [model-card (assoc c :available? true)])]
      [section-heading "新着作品" "#posts"]
      [public-gallery]]))

#?(:cljs
   (defn posts-view []
     (let [selected (r/atom nil)]
       (fn []
         [:div {:class "oppai-discovery"}
          [:div {:class "oppai-filter-row"}
           (for [[id label] [[nil "すべて"] ["animagine-xl-4.0" "アニメ"] ["waiREALMIX_v11" "写実"]]]
             ^{:key label} [:button {:class "oppai-filter" :aria-pressed (= id @selected)
                                    :on-click #(reset! selected id)} label])]
          [public-gallery nil @selected]]))))

#?(:cljs
   (defn post-detail-view []
     (let [id @(rf/subscribe [:detail-id])
           work (some #(when (= id (:id %)) %) catalog/public-works)]
       (if-not work
         [:div {:class "oppai-empty"} [:h2 "作品が見つかりません"] [:a {:href "#posts"} "投稿一覧へ"]]
         [:article {:class "oppai-detail"}
          [:img {:class "oppai-detail-image" :src (:image work) :alt (:title work)}]
          [:div {:class "oppai-detail-info"}
           [:a {:href "#posts"} "‹ 投稿一覧"]
           [:h2 (:title work)]
           [:p (if (:producer work) [:a {:href "#producer"} "✦ Producer · BOT"] "oppai.fans Studio")]
           [:p {:class "oppai-note"} "AI生成作品 · 768 × 768"]
           (when (seq (:tags work))
             [:div {:class "oppai-work-tags" :aria-label "制作タグ"}
              (for [tag (:tags work)] ^{:key tag} [:span tag])])
           [:h3 "使用モデル"] [:a {:href (str "#model/" (:model work))} (:model work)]
           (when (:prompt work) [:div [:h3 "制作プロンプト"] [:p {:class "oppai-prompt-copy"} (:prompt work)]])
           (ui/button (if (:prompt work) "このプロンプトで作成" "このモデルで作成")
                      {:variant :primary} #(rf/dispatch [:work/remix id]))
           [:p {:class "oppai-note"} "生成結果は毎回異なります。"]
           [:a {:href (:image work) :download (str id ".png")} "画像をダウンロード ↓"]]]))))

#?(:cljs
   (defn model-detail-view []
     (let [id @(rf/subscribe [:detail-id]) card (catalog/card-by-id id)
           live @(rf/subscribe [:fleet-image-models])
           free? (contains? #{"animagine-xl-4.0" "waiREALMIX_v11"} id)
           available? (or free? (some #(= id (:model-id %)) live))]
       (if-not card
         [:div {:class "oppai-empty"} [:h2 "モデルが見つかりません"] [:a {:href "#models"} "モデル一覧へ"]]
         [:div {:class "oppai-discovery"}
          [:a {:href "#models"} "‹ モデル一覧"]
          [:div {:class "oppai-model-description"}
           [:p {:class "oppai-note"} (str "CHECKPOINT · " (:base card) " · " (catalog/styles (:style card)))]
           [:h2 (:name card)] [:p (:tagline card)] [:p (:hint card)]
           (when free? [:p "無料プレビュー対応 · 768×768"])
           (ui/button (if free? "無料で生成" "このモデルで生成")
                      {:variant :primary :disabled (not available?)}
                      #(rf/dispatch [:image/choose-model id]))]
          [:h2 "このモデルの作品"] [public-gallery nil id]]))))

#?(:cljs
   (defn feedback-view []
     (let [form (r/atom {:category "bug" :message "" :page "#image" :error_id ""})
           busy? (r/atom false) result (r/atom nil) error (r/atom nil)]
       (fn []
         [:section {:class "oppai-studio"}
          [:h2 "ご意見・不具合・コメント"]
          [:p "初回なのに無料枠が使えない場合など、こちらからお知らせください。運営が定期的に確認します。"]
          [:p {:class "oppai-note"} "送信内容は運営のみが確認します（90日保存）。個人情報やパスワードは入力しないでください。エラー記録は30日保存します。"]
          [:form {:class "oppai-form" :on-submit (fn [event]
                              (.preventDefault event)
                              (reset! busy? true) (reset! error nil) (reset! result nil)
                              (net/submit-feedback!
                               {:body @form
                                :on-ok (fn [body] (reset! busy? false) (reset! result (:id body)) (swap! form assoc :message ""))
                                :on-error (fn [message] (reset! busy? false) (reset! error message))}))}
           (ui/field {:label "種類" :for "feedback-category"}
                     (ui/select {:id "feedback-category" :class "oppai-full" :value (:category @form) :on-change #(swap! form assoc :category (.. % -target -value))}
                                [["bug" "不具合"] ["idea" "改善要望"] ["comment" "コメント"]]))
           (ui/field {:label "内容" :for "feedback-message"}
                     (ui/text-area {:class "oppai-full" :id "feedback-message" :required true :max-length 2000 :rows 6 :value (:message @form)
                                 :on-change #(swap! form assoc :message (.. % -target -value))}))
           (ui/field {:label "画面" :for "feedback-page"}
                     (ui/select {:id "feedback-page" :class "oppai-full" :value (:page @form) :on-change #(swap! form assoc :page (.. % -target -value))}
                                [["#image" "画像生成"] ["#models" "モデル"] ["#posts" "投稿"] ["#home" "その他"]]))
           (ui/field {:label "エラー番号（任意）" :for "feedback-error"}
                     (ui/text-input {:class "oppai-full" :id "feedback-error" :max-length 36 :value (:error_id @form)
                              :on-change #(swap! form assoc :error_id (.. % -target -value))}))
           (ui/button (if @busy? "送信中…" "送信する") {:type "submit" :disabled @busy?})]
          (when @error [:p {:role "alert"} @error])
          (when @result [:p {:role "status"} (str "受け付けました。ありがとうございます。受付番号: " @result)])]))))

#?(:cljs
   (defn payments-view []
     (let [options @(rf/subscribe [:payments])
           text (:text options)
           price (:price text)]
       [:div {:class "oppai-payments"}
        [:section {:class "oppai-payment-card"}
         [:span {:class "oppai-eyebrow"} "PAY PER REQUEST"]
         [:h2 "x402 で文章を生成"]
         [:p "Base の USDC で、文章生成を1回ずつ購入できます。決済と生成は Murakumo の画面で行います。"]
         (cond
           (nil? options) [:p {:role "status"} "決済条件を確認しています…"]
           (= "available" (:status text))
           [:div
            [:p {:class "oppai-payment-price"} (:usd price) " USDC / 回"]
            [:dl
             [:dt "ネットワーク"] [:dd "Base Mainnet"]
             [:dt "決済サービス"] [:dd [:a {:href "https://x402.nexus"} "x402.nexus ↗"]]
             [:dt "受取先"] [:dd {:class "oppai-payment-address"} (:payTo price)]]
            (ui/button "Murakumo で決済して生成 ↗"
                       {:variant :primary :href (:checkout-url text)})
            [:p {:class "oppai-muted"} "移動先で最新の金額と内容を確認し、ご自身のウォレットで承認してください。"]]
           :else [:p {:role "status"} "現在、決済条件を確認できません。時間をおいて再確認してください。"])
         (ui/button "決済条件を再確認" {:on-click #(rf/dispatch [:payments/refresh])})]
        [:section {:class "oppai-payment-card"}
         [:span {:class "oppai-eyebrow"} "IMAGE CREDITS"]
         [:h2 "基本の画像生成は無料"]
         (ui/button "無料で画像を生成" {:variant :primary :href "#image"})
         [:p "Animagine XL 4.0 は残高補充なしで利用できます。x402 の文章生成を購入しても、このサイトの画像・動画生成残高は増えません。"]
         [:p {:class "oppai-muted"} "補充と生成アカウントの連携が整い次第、ここから購入できるようになります。"]]])))

#?(:cljs
   (defn app []
     (if-not @(rf/subscribe [:age-confirmed?])
       [age-gate]
       (let [tab @(rf/subscribe [:tab])
             active (case tab :model-detail :models :post-detail :posts (if (contains? #{:image :douga :face :chat} tab) :tools tab))]
         [:div {:class "oppai-shell"}
          [:header {:class "oppai-header"}
           [:details {:class "oppai-mobile-menu"
                      :on-key-down #(when (= "Escape" (.-key %))
                                      (.removeAttribute (.-currentTarget %) "open"))}
            [:summary {:aria-label "メニューを開く"} "☰"]
            [:div {:class "oppai-drawer" :on-click #(when (.closest (.-target %) "a")
                                                     (.removeAttribute (.closest (.-currentTarget %) "details") "open"))}
             (ui/tab-bar {:items db/tabs :active active})]]
           [:a {:class "oppai-brand" :href "#home" :aria-label "oppai.fans ホーム"}
            [:img {:class "oppai-brand-logo" :src "/img/oppai-logo-dark.svg"
                   :alt "oppai.fans" :width 220 :height 48}]]
           [:a {:class "oppai-search-shortcut" :href "#models" :aria-label "モデルを検索"} "⌕"]
           [:span {:class "oppai-header-caption"} "Create. Explore. Share."]
           (ui/button "＋ 作成" {:variant :primary :href "#image"})]
          [:aside {:class "oppai-sidebar"}
           (ui/tab-bar {:items db/tabs :active active})
           [:div {:class "oppai-sidebar-note"}
            (ui/chip "18+" {:color "gray"})
            [:p "モデルを選んで、アイデアをかたちに。"]
            [:a {:href "https://murakumo.cloud"} "murakumo.cloud ↗"]]]
          [:main {:class "oppai-home" :id "main-content"}
           [:div {:class "oppai-page-heading"}
            [:h1 (case tab :feedback "ご意見・不具合" :home "ホーム" :producer "Producer" :posts "投稿" :tools "AIツール" :payments "決済"
                        :model-detail "モデル詳細" :post-detail "作品詳細" :models "モデル" :image "画像作成" :douga "動画作成"
                        :face "自分の顔" :works "ライブラリ" "チャット")]]
           [:div {:class "oppai-main"}
            (case tab :feedback [feedback-view] :producer [producer-view] :payments [payments-view] :home [home-view] :posts [posts-view] :model-detail [model-detail-view] :post-detail [post-detail-view] :tools [tools-view]
                  :image [image-studio] :douga [douga-studio] :face [face-view]
                  :models [models-view] :works [works-view] [chat-studio])]]
          [:footer {:class "oppai-footer"} [:p "© 2026 oppai.fans"] [:nav {:aria-label "サイトリンク"} [:a {:href "#models"} "モデル"] " · " [:a {:href "#posts"} "投稿"] " · " [:a {:href "#producer"} "Producer"] " · " [:a {:href "#tools"} "AIツール"]]]]))))
