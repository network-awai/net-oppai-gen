(defn by-id [id] (some #(when (= id (:id %)) %) profiles))
(defn prompt [profile n]
  (str "masterpiece, best quality, fictional adult age 32, fully clothed, "
       (:cue profile) ", "
       (case (:keyword profile)
         "blonde-hair" "blonde hair"
         "sci-fi" "space station, futuristic city"
         "fantasy" "enchanted forest, traveling cloak"
         "dotpixel" "pixel art, visible pixel grid"
         "outdoor" "botanical garden, trees"
         "cosplay" "original space explorer costume"
         "uniform" "adult professional wearing a tailored hotel uniform"
         "stockings" "opaque stockings, knee length skirt, buttoned coat"
         (str "theme: " (:keyword profile)))
       ", " (nth ["waist up portrait, soft daylight" "full body, warm studio light"
                   "three quarter portrait, cinematic evening light"] (mod n 3))
       ", non-explicit, no nudity, no text"))

(defn choose [history]
  ;; Lowest successful count first; rotate ties by last attempt, then stable ID.
  ;; An outage doesn't count as a success or starve the remaining profiles.
  (first
    (sort-by (fn [p]
               (let [xs (filter #(= (:id p) (:profile %)) history)]
                 [(count (filter #(#{"generated" "published"} (:state %)) xs))
                  (or (last (sort (keep :hour xs))) "") (:id p)])) profiles)))
