# Cache policy. The pairing matters: index.html must always revalidate so a new
# deploy is picked up immediately, and the app bundle carries a content hash in
# its filename so it can safely be cached forever.
#
# Written after the 2026-08-01 incident on the sibling apex: a fresh index.html
# was served alongside a main.js the edge had held for 30 days, so the new
# stylesheet was applied to the old app. An unhashed asset path plus a long TTL
# is a deploy that only half lands.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
