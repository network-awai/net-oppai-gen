{
  "name": "oppai-fans",
  "private": true,
  "description": "oppai.fans — R18 image/video generation on the murakumo Mac mini fleet, in the デジタル庁デザインシステム. Age-gated.",
  "scripts": {
    "dev": "shadow-cljs watch app",
    "generate-site": "nbb --classpath src:test:scripts:../../kotoba-lang/jp-go-digital-design-system/src:../../kotoba-lang/html/src:../../kotoba-lang/css/src:../../kotoba-lang/text/src scripts/generate_site.cljs",
    "test": "nbb --classpath src:test:scripts:../../kotoba-lang/jp-go-digital-design-system/src:../../kotoba-lang/html/src:../../kotoba-lang/css/src:../../kotoba-lang/text/src scripts/run_tests.cljs",
    "build": "shadow-cljs release app worker && npm run generate-site",
    "deploy": "npm run build && wrangler deploy",
    "e2e": "nbb --classpath src:test:scripts:../../kotoba-lang/jp-go-digital-design-system/src:../../kotoba-lang/html/src:../../kotoba-lang/css/src:../../kotoba-lang/text/src scripts/verify-e2e.cljs",
    "smoke:prod": "nbb --classpath src:test:scripts:../../kotoba-lang/jp-go-digital-design-system/src:../../kotoba-lang/html/src:../../kotoba-lang/css/src:../../kotoba-lang/text/src scripts/prod-smoke.cljs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.20",
    "wrangler": "^4.20.0"
  }
}
