(ns producer-mcp
  "Local stdio MCP server, protocol 2025-11-25. No network listener or new credential."
  (:require [producer-publish :as p] ["readline" :as rl]))
(def ready (atom false))
(def tool-list
  [{:name "producer_list_posts" :description "List saved Producer receipts and their review/publication state."
    :inputSchema {:type "object" :properties {} :additionalProperties false}
    :annotations {:readOnlyHint true}}
   {:name "producer_publish" :description "Commit, push, build and deploy one reviewed free-generation receipt to oppai.fans. Requires exact image hash and current deployment version. Returns deployed; verify the public page separately before marking published."
    :inputSchema {:type "object" :properties {:hour {:type "string" :pattern "^[0-9]{8}T[0-9]{2}Z$"}
                                             :sha256 {:type "string" :pattern "^[a-f0-9]{64}$"}
                                             :expected_version {:type "string"}}
                  :required ["hour" "sha256" "expected_version"] :additionalProperties false}
    :annotations {:readOnlyHint false :destructiveHint false :idempotentHint true :openWorldHint true}}
   {:name "producer_verify_post"
    :description "Verify a deployed receipt against the active Cloudflare version and committed image/catalog. Read-only; reports deployment changes. Does not verify browser rendering or fetch the public image, and never marks published."
    :inputSchema {:type "object" :properties {:hour {:type "string" :pattern "^[0-9]{8}T[0-9]{2}Z$"}}
                  :required ["hour"] :additionalProperties false}
    :annotations {:readOnlyHint true :openWorldHint true}}])
(defn handle [m]
  (let [id (:id m) method (:method m)]
    (when (some? id)
      (try
        {:jsonrpc "2.0" :id id
         :result (case method
                   "initialize" (do (reset! ready true)
                                    {:protocolVersion "2025-11-25" :capabilities {:tools {}}
                                     :serverInfo {:name "oppai-producer" :version "1.0.0"}})
                   "ping" {}
                   (do
                     (when-not @ready (throw (js/Error. "Initialize first")))
                     (case method
                       "tools/list" {:tools tool-list}
                       "tools/call"
                       (try
                         (let [a (get-in m [:params :arguments])
                               result (case (get-in m [:params :name])
                                        "producer_list_posts" (p/pending)
                                        "producer_verify_post" (p/verify! (or (.-OPPAI_REPO js/process.env) (.cwd js/process)) (:hour a))
                                        "producer_publish" (p/publish! (or (.-OPPAI_REPO js/process.env) (.cwd js/process))
                                                                               (:hour a) (:sha256 a) (:expected_version a))
                                        (throw (js/Error. "Unknown tool")))]
                           {:content [{:type "text" :text (js/JSON.stringify (clj->js result))}]})
                         (catch :default e {:isError true :content [{:type "text" :text (.-message e)}]}))
                       (throw (js/Error. "Unknown method")))))}
        (catch :default e {:jsonrpc "2.0" :id id :error {:code -32601 :message (.-message e)}})))))
(def lines (rl/createInterface #js {:input (.-stdin js/process) :crlfDelay js/Infinity}))
(.on lines "line"
     (fn [line]
       (try
         (when (> (count line) 16384) (throw (js/Error. "Request too large")))
         (when-let [r (handle (js->clj (js/JSON.parse line) :keywordize-keys true))]
           (println (js/JSON.stringify (clj->js r))))
         (catch :default _ (println "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"Invalid JSON request\"}}")))))
